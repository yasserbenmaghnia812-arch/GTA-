<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background">

    <!-- Dark gradient overlay for contrast -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60D0D12" />

    <!-- TOP TOOLBAR -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#D9161620"
        android:elevation="4dp"
        android:layout_alignParentTop="true">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            android:padding="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SA-MP SERVERS"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/tvServerCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(0)"
            android:textColor="#FF3A30"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Nickname Chip Button -->
        <LinearLayout
            android:id="@+id/btnNickname"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_tab_unselected"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_person"
                android:contentDescription="Player" />

            <TextView
                android:id="@+id/tvPlayerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Player_Name"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Add Server Button -->
        <Button
            android:id="@+id/btnAddServer"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tab_unselected"
            android:drawableStart="@drawable/ic_add"
            android:drawablePadding="4dp"
            android:text="Add IP"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:paddingHorizontal="10dp" />

        <!-- Refresh Button -->
        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_refresh"
            android:contentDescription="Refresh"
            android:padding="8dp" />
    </LinearLayout>

    <!-- SEARCH & FILTER BAR -->
    <LinearLayout
        android:id="@+id/layoutSubHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutToolbar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:background="#80101018">

        <!-- Tabs -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tabInternet"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_tab_selected"
                android:text="Internet"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp" />

            <Button
                android:id="@+id/tabFavorites"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tab_unselected"
                android:text="Favorites"
                android:textColor="#CCCCCC"
                android:textSize="11sp"
                android:paddingHorizontal="12dp" />

            <Button
                android:id="@+id/tabRecents"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tab_unselected"
                android:text="Recent"
                android:textColor="#CCCCCC"
                android:textSize="11sp"
                android:paddingHorizontal="12dp" />

            <Button
                android:id="@+id/tabCurated"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tab_unselected"
                android:text="Curated"
                android:textColor="#CCCCCC"
                android:textSize="11sp"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Filter Toggles -->
        <CheckBox
            android:id="@+id/cbHideEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Non-Empty"
            android:textColor="#AAAAAA"
            android:textSize="10sp"
            android:buttonTint="#FF3A30" />

        <CheckBox
            android:id="@+id/cbNoPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="No Pass"
            android:textColor="#AAAAAA"
            android:textSize="10sp"
            android:buttonTint="#FF3A30" />

        <!-- Search Input -->
        <LinearLayout
            android:layout_width="160dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_search_field"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_search"
                android:contentDescription="Search" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Search server..."
                android:textColorHint="#66FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- CONTENT AREA -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutSubHeader"
        android:layout_above="@id/layoutBottomStatus">

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvServers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />

        <!-- Loading View -->
        <LinearLayout
            android:id="@+id/layoutLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="#FF3A30" />

            <TextView
                android:id="@+id/tvLoadingMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fetching SA-MP servers..."
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Empty View -->
        <LinearLayout
            android:id="@+id/layoutEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivEmptyIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_server"
                android:alpha="0.4"
                android:contentDescription="Empty" />

            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Servers Found"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvEmptyDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Try refreshing or adding a custom server with Add IP."
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:gravity="center" />
        </LinearLayout>
    </FrameLayout>

    <!-- BOTTOM STATUS BAR -->
    <LinearLayout
        android:id="@+id/layoutBottomStatus"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="#F0111116">

        <TextView
            android:id="@+id/tvStatusServer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Select a server to play"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btnQuickConnect"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_button_connect"
            android:text="CONNECT"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="16dp"
            android:enabled="false" />
    </LinearLayout>

</RelativeLayout>
