<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_custom"
    android:padding="20dp"
    android:minWidth="340dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Custom Server"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter the IP address or domain and port of the SA-MP server."
        android:textColor="#888888"
        android:textSize="11sp"
        android:layout_marginTop="2dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2E2E3E"
        android:layout_marginVertical="10dp" />

    <!-- IP & Port Inputs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SERVER IP / HOST"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAddHost"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/bg_search_field"
                android:hint="127.0.0.1 or domain"
                android:textColorHint="#66FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PORT"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAddPort"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/bg_search_field"
                android:text="7777"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:inputType="number"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Server Name (Optional) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SERVER NAME (OPTIONAL)"
        android:textColor="#AAAAAA"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp" />

    <EditText
        android:id="@+id/etAddName"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_search_field"
        android:hint="My Favorite SA-MP Server"
        android:textColorHint="#66FFFFFF"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:paddingHorizontal="10dp"
        android:singleLine="true"
        android:layout_marginTop="4dp" />

    <!-- Ping Test Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnAddTestPing"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_tab_unselected"
            android:text="TEST QUERY"
            android:textColor="#CCCCCC"
            android:textSize="10sp"
            android:paddingHorizontal="10dp" />

        <TextView
            android:id="@+id/tvAddPingResult"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="#00E676"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnAddCancel"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_tab_unselected"
            android:text="CANCEL"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:paddingHorizontal="16dp" />

        <Button
            android:id="@+id/btnAddSave"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_button_connect"
            android:text="SAVE TO FAVORITES"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="16dp" />
    </LinearLayout>

</LinearLayout>
